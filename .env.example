# WasteWatch AI — backend configuration.
# Copy to .env (or export these) before running uvicorn.

# --- NVIDIA Nemotron on Nebius Token Factory (REQUIRED to enable the AI layer) -
# Create a key at https://tokenfactory.nebius.com and paste the EXACT base URL +
# model IDs shown in your dashboard (they vary by region). If NEBIUS_API_KEY is
# unset, WasteWatch runs the deterministic CV pipeline only — no mock AI.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
NEMOTRON_VL_MODEL=nvidia/Nemotron-3.5-Super-VL
NEMOTRON_REASON_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_DEEP_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# --- Optional: Tavily live-news enrichment (Best Use of Tavily prize) ----------
# Without it, the news signal is simply skipped; OSM + air quality still run.
TAVILY_API_KEY=

# --- Human review -------------------------------------------------------------
REVIEWER_TOKEN=dev-reviewer-token

# --- Cost-aware rate limiting (see app/ratelimit.py) --------------------------
# On by default. Tiered by cost: expensive = inspections (CV + paid Nemotron +
# Sentinel-2 egress), moderate = external-API lookups, cheap = local reads.
# Limits are per-client-IP and HIGHLY DYNAMIC: the expensive tier auto-tightens
# as the daily AI budget depletes and as concurrency rises, and can be tuned at
# runtime via POST /admin/limits (no redeploy). GET /limits shows live state.
RL_ENABLED=on
RL_ADAPT=on                       # adaptive tightening on/off
RL_EXPENSIVE_PER_HOUR=20          # inspections per client per hour
RL_MODERATE_PER_MIN=30            # scene/geocode lookups per client per minute
RL_CHEAP_PER_MIN=240              # dashboard/reads per client per minute
RL_TRUST_FORWARDED=on             # trust x-forwarded-for (behind the Vercel proxy)
# Sustainability lever: rolling 24h ceiling on PAID Nemotron calls. When hit,
# inspections keep running but skip the AI brief (CV-only) — never mocked.
AI_BUDGET_CALLS_PER_DAY=500

# --- Legacy (off by default) --------------------------------------------------
# ORBIT_ADVISER=on
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
